generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SENT
  FAILED
  WITHDRAWN
}

enum ApplicationMode {
  AUTO
  MANUAL
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  applicantProfiles       ApplicantProfile[]
  documents               Document[]
  searchProfiles          SearchProfile[]
  applications            Application[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  clickEvents             ClickEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Kern (Vertical-unabhängig) ----------

/// Ein Suchbereich wie "housing", später "jobs", "kita", "school".
/// Die Definition (Schemas, Scoring) liegt im Code unter src/verticals/<key>.
model Vertical {
  key    String  @id
  name   String
  active Boolean @default(true)

  sources           Source[]
  listings          Listing[]
  applicantProfiles ApplicantProfile[]
  searchProfiles    SearchProfile[]
}

model Partner {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  website              String?
  /// Platzhalter {url} wird durch die URL der Anzeige ersetzt.
  affiliateUrlTemplate String?
  sponsored            Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  sources     Source[]
  listings    Listing[]
  clickEvents ClickEvent[]
}

/// Spiegel der im Code registrierten Quellen-Adapter.
model Source {
  key           String    @id
  name          String
  verticalKey   String
  partnerId     String?
  supportsApply Boolean   @default(false)
  active        Boolean   @default(true)
  lastImportAt  DateTime?

  vertical Vertical  @relation(fields: [verticalKey], references: [key])
  partner  Partner?  @relation(fields: [partnerId], references: [id])
  listings Listing[]
}

model Listing {
  id          String    @id @default(cuid())
  verticalKey String
  sourceKey   String
  externalId  String
  partnerId   String?
  title       String
  url         String
  city        String?
  /// Vertical-spezifische Felder, validiert über das Zod-Schema des Verticals.
  data        Json
  contentHash String
  sponsored   Boolean   @default(false)
  active      Boolean   @default(true)
  publishedAt DateTime?
  importedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vertical     Vertical      @relation(fields: [verticalKey], references: [key])
  source       Source        @relation(fields: [sourceKey], references: [key])
  partner      Partner?      @relation(fields: [partnerId], references: [id])
  matches      Match[]
  applications Application[]
  clickEvents  ClickEvent[]

  @@unique([sourceKey, externalId])
  @@index([verticalKey, active])
  @@index([contentHash])
}

model ApplicantProfile {
  id                  String   @id @default(cuid())
  userId              String
  verticalKey         String
  data                Json
  coverLetterTemplate String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical Vertical @relation(fields: [verticalKey], references: [key])

  @@unique([userId, verticalKey])
}

/// Hochgeladene Nachweise, AES-256-GCM-verschlüsselt außerhalb von public/.
model Document {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  iv         String
  authTag    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchProfile {
  id                 String    @id @default(cuid())
  userId             String
  verticalKey        String
  name               String
  criteria           Json
  scoreThreshold     Int       @default(70)
  autoApply          Boolean   @default(false)
  autoApplyConsentAt DateTime?
  dailyApplyLimit    Int       @default(5)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical     Vertical      @relation(fields: [verticalKey], references: [key])
  matches      Match[]
  applications Application[]

  @@index([verticalKey, active])
}

model Match {
  id              String    @id @default(cuid())
  searchProfileId String
  listingId       String
  score           Int
  /// Ein hartes Kriterium ist verletzt (z. B. Miete weit über Budget).
  excluded        Boolean   @default(false)
  /// [{ criterion, ok, points, maxPoints, text }]
  reasons         Json
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  searchProfile SearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  application   Application?

  @@unique([searchProfileId, listingId])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  listingId       String
  searchProfileId String?
  matchId         String?           @unique
  status          ApplicationStatus @default(DRAFT)
  mode            ApplicationMode
  coverLetter     String
  externalRef     String?
  error           String?
  sentAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile? @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)
  match         Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([userId, listingId])
  @@index([userId, status, sentAt])
}

model NotificationPreference {
  id          String    @id @default(cuid())
  userId      String
  channel     Channel
  destination String
  enabled     Boolean   @default(false)
  optInAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  channel   Channel
  type      String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  error     String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Klick auf einen Partner-Link. Bewusst ohne IP und User-Agent (Datenminimierung).
model ClickEvent {
  id        String   @id @default(cuid())
  listingId String
  partnerId String?
  userId    String?
  placement String
  createdAt DateTime @default(now())

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
}

/// Nur Entwicklung: E-Mails landen hier, wenn kein SMTP konfiguriert ist.
model DevMail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())
}
