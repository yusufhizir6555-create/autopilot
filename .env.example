# Datenbank
DATABASE_URL="postgresql://app:app@localhost:5432/wohnungssuche"

# Auth.js – zufälliger String, z. B. `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Komma-getrennte E-Mails, die beim Login automatisch Admin werden
ADMIN_EMAILS=""

# Dokument-Verschlüsselung: 32 Byte, base64 (`openssl rand -base64 32`)
DOCUMENT_ENCRYPTION_KEY=""
DOCUMENT_STORAGE_DIR="./storage"

# Schutz für /api/cron/[job]
CRON_SECRET=""

# E-Mail (leer lassen = Dev-Mailbox unter /dev/mailbox)
EMAIL_FROM="Wohnungssuche <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Nur für lokale Tests mit `next start`: Dev-Mailbox trotz Produktionsmodus zeigen. NIE auf einem Server setzen.
# ENABLE_DEV_MAILBOX="true"

# SMS / WhatsApp (leer lassen = Log-Stub)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
